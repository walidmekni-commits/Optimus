# AI assistant: paste your Anthropic API key here, or in the app under Settings
ANTHROPIC_API_KEY=

# Solver: "simulated" (no PLAXIS, fake results) or "plaxis" (remote scripting server)
SOLVER_BACKEND=simulated
PLAXIS_HOST=localhost
PLAXIS_INPUT_PORT=10000
PLAXIS_PASSWORD=your-remote-scripting-password

# Who gets the error emails
USER_EMAIL=you@example.com
ADMIN_EMAIL=admin@example.com

# SMTP for outgoing email (if unset, emails are printed to the console instead)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=you@example.com
SMTP_PASSWORD=app-password
SMTP_FROM=you@example.com

# Engine
MAX_RETRIES=3
RETRY_DELAY_SECONDS=2
MAX_RUNS=200
DATA_DIR=data
DB_PATH=automation.db

# Cross sections: CAD only (DXF / DWG, plus CSV tables). PDF_IMPORT=1 brings back PDF, scan and picture reading
# (experimental: PDF geometry is often unreliable, see README)
PDF_IMPORT=0
